  {"id": "rust", "upstream": "BurntSushi/ripgrep", "fork": "NanthAI/bench-zoo-rust", "ref": "master"},
  {"id": "jvm", "upstream": "square/kotlinpoet", "fork": "NanthAI/bench-zoo-jvm", "ref": "main"},
  {"id": "mixed", "upstream": "pydantic/jiter", "fork": "NanthAI/bench-zoo-mixed", "ref": "main"}
 ]
