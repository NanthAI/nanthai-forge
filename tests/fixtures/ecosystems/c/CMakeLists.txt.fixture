cmake_minimum_required(VERSION 3.25)
project(greeter C CXX)
enable_testing()
add_library(greeter src/greeter.c)
target_include_directories(greeter PUBLIC include)
add_executable(greeter_test tests/greeter_test.cpp)
target_link_libraries(greeter_test greeter)
add_test(NAME greeter COMMAND greeter_test)
