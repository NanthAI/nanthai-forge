{
  "name": "@nanthai/forge",
  "version": "0.3.1",
  "private": true,
  "description": "Local native source, Intent/Lane workflows and source context for NanthAi:Forge",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "forge": {
    "preflight": {
      "static": [
        {
          "name": "foundation",
          "script": "check"
        },
        {
          "name": "format",
          "script": "format:check",
          "inputs": [
            "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
            ".oxfmtrc.json",
            ".gitignore"
          ]
        },
        {
          "name": "documents",
          "command": [
            "node",
            "scripts/check-documents.mjs"
          ],
          "inputs": [
            "docs/**",
            "*.md",
            "package.json",
            "scripts/package-documents*",
            "scripts/selfhost-notices.mjs"
          ]
        },
        {
          "name": "packaged scripts",
          "command": [
            "node",
            "--test",
            "tests/packaged-scripts.test.mjs"
          ],
          "inputs": [
            "scripts/**",
            "src/**",
            "package.json"
          ]
        },
        {
          "name": "schema compatibility",
          "command": [
            "node",
            "scripts/check-schema-compat.mjs"
          ],
          "inputs": [
            "convex/**",
            "scripts/check-schema-compat.mjs"
          ]
        },
        {
          "name": "convex runtime imports",
          "command": [
            "node",
            "scripts/check-convex-runtime.mjs"
          ],
          "inputs": [
            "convex/**",
            "package.json",
            "package-lock.json",
            "scripts/check-convex-runtime.mjs"
          ]
        }
      ],
      "guards": [
        {
          "name": "convex runtime imports",
          "tests": [
            "tests/convex-runtime-imports.test.mjs"
          ],
          "inputs": [
            "src/**",
            "convex/**",
            "scripts/check-convex-*.mjs",
            "package.json"
          ]
        },
        {
          "name": "hot storage invariant",
          "tests": [
            "tests/hot-storage-invariant.test.mjs"
          ],
          "inputs": [
            "convex/**"
          ]
        },
        {
          "name": "agent response contract",
          "tests": [
            "tests/hosted-response-contract.test.mjs"
          ],
          "inputs": [
            "src/hosted-*contract*.ts",
            "src/hosted-response*.ts",
            "src/agent-response-*.ts",
            "scripts/response-compat*",
            "convex/projectHostedAgent*.ts"
          ]
        },
        {
          "name": "cleanup process coverage",
          "tests": [
            "tests/clean-processes.test.mjs"
          ],
          "inputs": [
            "src/clean-processes.ts",
            "src/lane-prune.ts",
            "src/client-cache-gc.ts",
            "tests/automatic-cleanup.mjs",
            "tests/cleanup-process-fixture.mjs"
          ]
        }
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-foundation.mjs",
    "build": "npm run build:core && npm run build:web",
    "typecheck": "node scripts/prepare-convex-api.mjs && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false --types \"*\" --noEmit && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false --types \"*\" -p web/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false --types \"*\" -p convex/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false -p netlify/tsconfig.json",
    "lint": "node scripts/oxc.mjs lint",
    "test": "npm run build && node --import ./tests/check-runtime.mjs --test tests/*.test.mjs",
    "forge": "node dist/cli-entry.js",
    "verify": "node scripts/verify.mjs",
    "verify:sequential": "node scripts/prepare-convex-api.mjs && npm run check && npm run check:schema && npm run format:check && npm run typecheck && npm run lint && npm test",
    "build:core": "node scripts/prepare-convex-api.mjs && node node_modules/@typescript/native/bin/tsc --types \"*\" --noUncheckedSideEffectImports false && node scripts/build-edit-hook.mjs && node scripts/build-cli-bundle.mjs",
    "build:web": "vite build web --mode hosted --config web/vite.config.ts",
    "build:hosted": "npm run build:web",
    "dev:hosted": "vite web --mode hosted --config web/vite.config.ts",
    "smoke:hosted": "node --env-file=.env.local scripts/smoke-hosted.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "package:notices": "node scripts/package-notices.mjs",
    "package:local": "node scripts/package-local.mjs",
    "format": "node scripts/oxc.mjs format",
    "format:check": "node scripts/oxc.mjs format:check",
    "typecheck:tsc": "node scripts/prepare-convex-api.mjs && node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p web/tsconfig.json && node node_modules/typescript/bin/tsc -p convex/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p netlify/tsconfig.json",
    "build:core:tsc": "node scripts/prepare-convex-api.mjs && node node_modules/typescript/bin/tsc && node scripts/build-edit-hook.mjs && node scripts/build-cli-bundle.mjs",
    "model:landing-queue": "nforge heavy node models/landing-queue/run.mjs",
    "check:schema": "node scripts/check-schema-compat.mjs",
    "check:brief": "node scripts/check-brief.mjs",
    "schema:snapshot": "node scripts/refresh-schema-snapshot.mjs",
    "response:snapshot": "node scripts/refresh-response-snapshot.mjs",
    "response:main": "node scripts/refresh-response-snapshot.mjs --main"
  },
  "dependencies": {
    "@clerk/react": "6.17.3",
    "@lezer/common": "1.5.3",
    "@lezer/go": "1.0.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/java": "1.1.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.126",
    "ignore": "7.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.1",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.0"
  },
  "bin": {
    "nforge": "dist/cli-entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "files": [
    "skills/forge-agent/SKILL.md",
    "scripts/child-env.mjs",
    "scripts/filesystem-event-health.mjs",
    "scripts/filesystem-event-health-worker.mjs",
    "scripts/self-hosted-runner/start.mjs",
    "scripts/self-hosted-runner/Dockerfile",
    "scripts/child-env.d.mts",
    "scripts/main-module.mjs",
    "scripts/main-module.d.mts",
    "scripts/node-runtime.mjs",
    "scripts/check-quarantine.mjs",
    "scripts/check-documentation.mjs",
    "scripts/github-actions-check.mjs",
    "scripts/check-command-env.mjs",
    "scripts/check-packages-run.mjs",
    "scripts/check-packages-run.d.mts",
    "scripts/actions-capacity.mjs",
    "scripts/check-phases.mjs",
    "scripts/control-build-key.mjs",
    "scripts/control-deps-key.mjs",
    "scripts/hosted-actions-execute.mjs",
    "scripts/hosted-actions-job.mjs",
    "scripts/test-impact.mjs",
    "scripts/check-contract.mjs",
    "scripts/check-contract.d.mts",
    "scripts/selection-guard.mjs",
    "scripts/selection-guard.d.mts",
    "scripts/agent-default-lines.mjs",
    "scripts/agent-default-lines.d.mts",
    "scripts/test-import-graph.mjs",
    "scripts/test-name-watchers.mjs",
    "scripts/test-closeness.mjs",
    "scripts/test-tiebreak.mjs",
    "scripts/test-tiebreak.d.mts",
    "scripts/docs-readers.mjs",
    "scripts/test-tree-scanners.mjs",
    "scripts/convex-function-names.mjs",
    "scripts/test-directory-path.mjs",
    "scripts/test-coverage.mjs",
    "scripts/test-coverage.d.mts",
    "scripts/script-impact.mjs",
    "scripts/test-impact.d.mts",
    "scripts/test-shards.mjs",
    "scripts/test-shards.d.mts",
    "scripts/shard-pool.mjs",
    "scripts/shard-pool.d.mts",
    "scripts/test-timings-file.mjs",
    "scripts/test-timings-file.d.mts",
    "scripts/check-path-scopes.mjs",
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSE-Apache-2.0.txt",
    "LICENSE-AGPL-3.0-only.txt",
    "web/src/assets/NOTICE.md",
    "THIRD_PARTY_NOTICES.txt",
    "docs"
  ],
  "types": "./dist/index.d.ts"
}
