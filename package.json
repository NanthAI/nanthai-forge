{
  "name": "@nanthai/forge",
  "version": "0.3.1",
  "private": true,
  "description": "Local native source, Intent/Lane workflows and source context for NanthAi:Forge",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "check": "node scripts/check-foundation.mjs",
    "build": "npm run build:core && npm run build:web",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false --types \"*\" --noEmit && node node_modules/typescript/bin/tsc -p web/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false --types \"*\" -p convex/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc --noUncheckedSideEffectImports false -p netlify/tsconfig.json",
    "lint": "node scripts/oxc.mjs lint",
    "test": "npm run build && node --import ./tests/check-runtime.mjs --test tests/*.test.mjs",
    "forge": "node dist/cli-entry.js",
    "verify": "node scripts/verify.mjs",
    "verify:sequential": "npm run check && npm run check:schema && npm run format:check && npm run typecheck && npm run lint && npm test",
    "build:core": "node node_modules/@typescript/native/bin/tsc --types \"*\" --noUncheckedSideEffectImports false && node scripts/build-edit-hook.mjs",
    "build:web": "vite build web --mode hosted --config web/vite.config.ts",
    "build:hosted": "npm run build:web",
    "dev:hosted": "vite web --mode hosted --config web/vite.config.ts",
    "smoke:hosted": "node --env-file=.env.local scripts/smoke-hosted.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "package:notices": "node scripts/package-notices.mjs",
    "package:local": "node scripts/package-local.mjs",
    "format": "node scripts/oxc.mjs format",
    "format:check": "node scripts/oxc.mjs format:check",
    "typecheck:tsc": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p web/tsconfig.json && node node_modules/typescript/bin/tsc -p convex/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p netlify/tsconfig.json",
    "build:core:tsc": "node node_modules/typescript/bin/tsc && node scripts/build-edit-hook.mjs",
    "check:schema": "node scripts/check-schema-compat.mjs",
    "schema:snapshot": "node scripts/refresh-schema-snapshot.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.17.3",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/java": "1.1.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.0.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.126",
    "ignore": "7.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.1",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.0"
  },
  "bin": {
    "nforge": "dist/cli-entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "files": [
    "skills/forge-agent/SKILL.md",
    "scripts/child-env.mjs",
    "scripts/self-hosted-runner/start.mjs",
    "scripts/self-hosted-runner/Dockerfile",
    "scripts/child-env.d.mts",
    "scripts/node-runtime.mjs",
    "scripts/check-quarantine.mjs",
    "scripts/check-documentation.mjs",
    "scripts/github-actions-check.mjs",
    "scripts/hosted-actions-execute.mjs",
    "scripts/hosted-actions-job.mjs",
    "scripts/modal-check/runner.py",
    "scripts/modal-check/collect.py",
    "scripts/modal-check/cost.py",
    "scripts/modal-check/worker.mjs",
    "scripts/modal-source/bridge.py",
    "scripts/modal-source/worker.mjs",
    "scripts/test-impact.mjs",
    "scripts/test-import-graph.mjs",
    "scripts/test-directory-path.mjs",
    "scripts/test-coverage.mjs",
    "scripts/test-coverage.d.mts",
    "scripts/script-impact.mjs",
    "scripts/test-impact.d.mts",
    "scripts/test-shards.mjs",
    "scripts/test-shards.d.mts",
    "scripts/test-timings-file.mjs",
    "scripts/test-timings-file.d.mts",
    "scripts/check-path-scopes.mjs",
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSE-Apache-2.0.txt",
    "LICENSE-AGPL-3.0-only.txt",
    "web/src/assets/NOTICE.md",
    "THIRD_PARTY_NOTICES.txt",
    "docs"
  ],
  "types": "./dist/index.d.ts"
}
